# ==============================================================================
# AI PERSONAL FINANCE TELEGRAM BOT — ENVIRONMENT VARIABLES
# ==============================================================================

# Node Environment
NODE_ENV=production

# Telegram Configuration
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...your_telegram_bot_token_here

# Secret string acak (minimal 8 karakter) untuk mengamankan webhook dari request palsu
# Telegram akan mengirimkan secret ini pada header 'X-Telegram-Bot-Api-Secret-Token'
TELEGRAM_WEBHOOK_SECRET=your_super_secret_webhook_token_12345678

# Daftar Telegram ID pengguna yang memiliki akses (pisahkan dengan koma jika lebih dari satu)
# Dapatkan Telegram ID Anda dari bot @userinfobot di Telegram
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# Database Configuration (PostgreSQL Neon / Supabase)
# Gunakan connection string dengan PgBouncer / Connection Pooler untuk Serverless Vercel
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# Direct connection string (diperlukan Prisma untuk menjalankan migrasi skema)
DIRECT_URL=postgresql://neondb_owner:password@ep-cool-direct.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# AI Configuration
# Pilihan: 'gemini' (rekomendasi, free tier Google AI Studio) atau 'groq'
AI_PROVIDER=gemini
# Masukkan API Key dari Google AI Studio (aistudio.google.com) atau Groq Cloud (console.groq.com)
AI_API_KEY=AIzaSy...your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Cron Protection Secret
# String rahasia untuk melindungi endpoint /api/cron/reminders
CRON_SECRET=your_random_cron_secret_key_87654321

# Application URL
# URL deployment Vercel Anda (misal: https://my-finance-bot.vercel.app)
APP_URL=https://your-bot-app.vercel.app

# Zona Waktu
# Default: Asia/Makassar (WITA, UTC+8)
TIMEZONE=Asia/Makassar
